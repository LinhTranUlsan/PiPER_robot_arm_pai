# Optional 4th camera: "all" -- mounted opposite `front`, seeing the whole rig.
#
#     source piper/env.sh          # must come FIRST: this file builds on $FRONT/$WRIST_*
#     source piper/env_all.sh
#     echo "$CAMS_RIGHT_ALL"
#
# Copy to env_all.sh and put your own by-path in ALL below. Gitignored, like env.sh.
#
# WHY A SEPARATE FILE
# env.sh is regenerated by `detect_cameras.py --write`, which only knows about front /
# wrist_right / wrist_left -- anything added there would be wiped on the next run. Keeping
# `all` here means nothing already working is touched: $CAMS_RIGHT, $CAMS_LEFT and
# $CAMS_BOTH keep exactly the camera sets the existing datasets and checkpoints were
# built with.
#
# by-path encodes this machine's PCI id and the camera's USB port, so update the line
# below by hand if this camera moves port. Find it with:
#     python piper/scripts/setup/detect_cameras.py

export ALL="/dev/v4l/by-path/REPLACE-ME-video-index0"

_cam() { printf '%s: {type: opencv, index_or_path: %s, width: 640, height: 480, fps: 30}' "$1" "$2"; }

# Single cluster + the overview camera. 3 streams.
export CAMS_RIGHT_ALL="{ $(_cam front "$FRONT"), $(_cam wrist "$WRIST_RIGHT"), $(_cam all "$ALL")}"
export CAMS_LEFT_ALL="{ $(_cam front "$FRONT"), $(_cam wrist "$WRIST_LEFT"), $(_cam all "$ALL")}"

# Both clusters + the overview camera, for --robot.type=piper_bimanual. 4 streams.
export CAMS_BOTH_ALL="{ $(_cam front "$FRONT"), $(_cam wrist_right "$WRIST_RIGHT"), $(_cam wrist_left "$WRIST_LEFT"), $(_cam all "$ALL")}"

unset -f _cam

if [ -z "$FRONT" ]; then
    echo "  WARNING: \$FRONT is empty -- source piper/env.sh first" >&2
else
    echo "  ALL             : $ALL"
    echo "  CAMS_RIGHT_ALL  : front + wrist + all   (3 streams)"
    echo "  CAMS_LEFT_ALL   : front + wrist + all   (3 streams)"
    echo "  CAMS_BOTH_ALL   : front + 2 wrists + all (4 streams)"
fi
