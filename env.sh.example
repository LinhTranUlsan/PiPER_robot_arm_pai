# Copy to env.sh, then let the setup scripts fill it in:
#
#     cp env.sh.example env.sh
#     python scripts/setup/detect_cameras.py
#     python scripts/setup/identify_cameras.py
#     python scripts/setup/detect_cameras.py --front F --wrist-right R --wrist-left L --write
#     source env.sh
#
# env.sh is gitignored: by-path embeds THIS machine's PCI id and each camera's USB port.
export PIPER_REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# One fixed camera on the scene, one wrist camera per master-follower cluster.
export FRONT="/dev/v4l/by-path/REPLACE-ME-video-index0"
export WRIST_RIGHT="/dev/v4l/by-path/REPLACE-ME-video-index0"
export WRIST_LEFT="/dev/v4l/by-path/REPLACE-ME-video-index0"

# Ready to paste into --robot.cameras. Pick the one matching your --can.
export CAMS_RIGHT="{ front: {type: opencv, index_or_path: $FRONT, width: 640, height: 480, fps: 30}, wrist: {type: opencv, index_or_path: $WRIST_RIGHT, width: 640, height: 480, fps: 30}}"
export CAMS_LEFT="{ front: {type: opencv, index_or_path: $FRONT, width: 640, height: 480, fps: 30}, wrist: {type: opencv, index_or_path: $WRIST_LEFT, width: 640, height: 480, fps: 30}}"

# For --robot.type=piper_bimanual (both clusters, one dataset).
export CAMS_BOTH="{ front: {type: opencv, index_or_path: $FRONT, width: 640, height: 480, fps: 30}, wrist_right: {type: opencv, index_or_path: $WRIST_RIGHT, width: 640, height: 480, fps: 30}, wrist_left: {type: opencv, index_or_path: $WRIST_LEFT, width: 640, height: 480, fps: 30}}"

# The CAN bus is NOT set here on purpose. Use scripts/can/can_env.sh, which resolves each
# adapter by USB serial: correct whether the kernel named it can_right, can0, or can1.
